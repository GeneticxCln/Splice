# Maintainer: GeneticxCln <GeneticxCln@users.noreply.github.com>
#
# The release workflow publishes this file with the real checksum filled in.
# Built from the source tarball attached to the GitHub release.
pkgname=splice-editor
pkgver=1.4.1
pkgrel=1
pkgdesc='Native Linux timeline video editor built on ffmpeg'
arch=('x86_64')
url='https://github.com/GeneticxCln/Splice'
license=('MIT')
depends=('ffmpeg' 'alsa-lib' 'libglvnd' 'fontconfig' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=(
  'ttf-dejavu: default UI and title font'
  'zenity: native file chooser'
  'kdialog: native file chooser on KDE'
  'wayland: Wayland session support'
  'libxkbcommon: keyboard handling'
)
source=("Splice-$pkgver.tar.gz::$url/releases/download/v$pkgver/Splice-$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "Splice-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Splice-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "Splice-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen
}

package() {
  cd "Splice-$pkgver"
  install -Dm755 target/release/splice "$pkgdir/usr/bin/splice"
  install -Dm644 packaging/splice.desktop "$pkgdir/usr/share/applications/splice.desktop"
  install -Dm644 packaging/splice.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/splice.svg"
  install -Dm644 packaging/splice-project.xml "$pkgdir/usr/share/mime/packages/splice-project.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
